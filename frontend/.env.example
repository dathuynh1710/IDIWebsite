# IDI Seafood — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Application name and Laravel REST API base URL.
# All VITE_* values are public and can be included in the browser bundle.
VITE_APP_NAME="IDI Seafood CMS"
VITE_API_URL=http://localhost:8000/api

# Optional content API. Leave empty to keep using the current local seed data.
VITE_API_BASE_URL=

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mapbox token (for interactive world map)
VITE_MAPBOX_TOKEN=pk.eyXXXXXXXX

# Contact form endpoint (e.g., Formspree, Netlify Forms, or custom backend)
VITE_INQUIRY_ENDPOINT=https://formspree.io/f/XXXXXXXX

# Site URL (used in SEO helpers)
VITE_SITE_URL=https://idiseafood.com
